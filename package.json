	"license": "MIT",
	"dependencies": {
		"@11ty/eleventy-fetch": "^6.0.1",
		"@11ty/eleventy-utils": "^3.0.1",
		"@11ty/gray-matter": "^3.0.0",
		"@11ty/posthtml-urls": "^2.0.0",
		"@prettier/sync": "^0.6.1",
		"@sindresorhus/slugify": "^3.0.1",
		"@zachleat/turndown": "^7.2.0",
		"entities": "^8.1.0",
		"fast-xml-parser": "^5.11.2",
		"filesize": "^11.0.28",
		"js-yaml": "^5.5.0",
